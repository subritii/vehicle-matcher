# The read-only showcase for the free live demo (render.yaml): the web app and the prebuilt
# bundle in showcase/ (tools/build_showcase.py). No OCR, plate reader or AI packages; runs
# in well under 512 MB.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    DEMO_MODE=showcase DATA_DIR=/tmp/showcase PORT=8000

WORKDIR /app
COPY requirements-showcase.txt ./
RUN pip install -r requirements-showcase.txt

RUN useradd --create-home --uid 1000 app
COPY --chown=app:app app/ app/
COPY --chown=app:app results/ results/
COPY --chown=app:app showcase/ showcase/
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/healthz', timeout=4)"
# --proxy-headers: behind Render's proxy, the rate limit counts per visitor, not per proxy.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*' --workers 1"]
