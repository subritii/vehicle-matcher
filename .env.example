# Copy to .env and adjust. .env is gitignored.

DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data

# paddle | tesseract
OCR_ENGINE=paddle
# Seconds allowed per image; a slower image is killed, treated as unreadable and sent to review. 0 = no limit.
OCR_TIMEOUT=120

# north_america: every VIN must carry a check digit (US/Canada shops). any: only VINs
# starting 1-5; use this if you service European/Asian-market imports.
VIN_MARKET=north_america

# Optional local vision model via Ollama. Leave empty to run with rules + OCR only.
# Chosen for an 8 GB M1 (3.2 GB loaded): `ollama pull qwen3.5:4b-q4_K_M`.
# See results/vision_model_choice.md.
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
# Seconds per vision request
OLLAMA_TIMEOUT=300

# NHTSA vPIC (free, no key)
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
VPIC_TIMEOUT=10

# tools/fetch_exteriors.py: Wikimedia requires contact details (your email or a URL) in the User-Agent
WIKIMEDIA_CONTACT=

# full: the whole pipeline. showcase: the read-only public demo served from showcase/
# (built by tools/build_showcase.py); allows public visitors, with a rate limit.
DEMO_MODE=full
SHOWCASE_DIR=showcase
# Requests per minute per visitor in showcase mode (pages; review decisions)
SHOWCASE_RATE_LIMIT=120
SHOWCASE_POST_LIMIT=20
