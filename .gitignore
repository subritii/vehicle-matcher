.venv/
.env
__pycache__/
*.pyc
.pytest_cache/

# Uploaded originals and the local DB. The .gitkeep keeps the folder in the repo.
data/*
!data/.gitkeep

# Real customer invoices/photos. Never commit these.
tests/fixtures/private/

# Generated by tools/make_fixtures.py (deterministic; regenerate instead of committing)
tests/fixtures/synthetic/
tests/fixtures/synthetic_hard/

# Exterior photos from Wikimedia Commons (tools/fetch_exteriors.py). exteriors.csv with the
# licenses and authors is committed; the images are re-downloaded.
tests/fixtures/exteriors/*.jpg

# Instructions for the coding assistant: local only
claude.md
CLAUDE.md
